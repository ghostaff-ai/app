{
  "name": "ghostaff",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "app:start": "pnpm --filter ghostaff-mobile start",
    "app:web": "pnpm --filter ghostaff-mobile web",
    "app:ios": "pnpm --filter ghostaff-mobile ios",
    "app:android": "pnpm --filter ghostaff-mobile android",
    "app:test": "pnpm --filter ghostaff-mobile test",
    "app:typecheck": "pnpm --filter ghostaff-mobile typecheck",
    "shared:test": "pnpm --filter @ghostaff/shared test",
    "shared:typecheck": "pnpm --filter @ghostaff/shared typecheck",
    "sync:test": "pnpm --filter @ghostaff/sync test",
    "sync:typecheck": "pnpm --filter @ghostaff/sync typecheck",
    "scripts:test": "bash scripts/metro-port.test.sh",
    "sync:por-decidir": "pnpm --filter @ghostaff/sync por-decidir",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "typecheck": "pnpm shared:typecheck && pnpm sync:typecheck && pnpm engine:typecheck && pnpm app:typecheck",
    "test": "pnpm shared:test && pnpm sync:test && pnpm engine:test && pnpm app:test && pnpm scripts:test",
    "check": "pnpm typecheck && pnpm test",
    "prepare": "husky",
    "engine:dev": "pnpm --filter @ghostaff/engine dev",
    "engine:test": "pnpm --filter @ghostaff/engine test",
    "engine:typecheck": "pnpm --filter @ghostaff/engine typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "husky": "^9.1.7",
    "supabase": "^3.1.0",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase",
      "esbuild"
    ]
  }
}
