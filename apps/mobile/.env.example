# Per environment. `pnpm db:start` prints the local URL and anon (publishable) key.
# The anon key is public by design (it ships in every app); row-level security is
# what keeps organisations apart. Never put the service-role key here.
SUPABASE_URL_DEV=http://127.0.0.1:54321
SUPABASE_ANON_KEY_DEV=
SUPABASE_URL_BETA=
SUPABASE_ANON_KEY_BETA=
SUPABASE_URL_PROD=
SUPABASE_ANON_KEY_PROD=
