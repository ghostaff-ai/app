{
  "name": "ghostaff-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "port=$(bash ../../scripts/metro-port.sh 8083) && expo start --port $port",
    "web": "port=$(bash ../../scripts/metro-port.sh 8083) && expo start --web --port $port",
    "android": "port=$(bash ../../scripts/metro-port.sh 8083) && expo run:android --port $port",
    "ios": "port=$(bash ../../scripts/metro-port.sh 8083) && expo run:ios --port $port",
    "export:web": "expo export --platform web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@ghostaff/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.58.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "^58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-gl": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "nativewind": "^4.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0",
    "semver": "^7.8.6",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/three": "^0.187.0",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.3.0",
    "typescript": "~6.0.3"
  }
}
