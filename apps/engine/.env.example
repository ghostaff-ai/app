# Local run against `pnpm db:start`: copy to apps/engine/.env and run `pnpm engine:dev`.
# The service-role key below is the local stack's (printed by `supabase status`), never a hosted one.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
# Keys kept in memory and lost on restart; production uses Secret Manager.
VAULT=memory
# Production only (GCP_PROJECT also turns dictation on: Gemini on Vertex AI in
# the EU, billed to that project, with your `gcloud auth application-default login`):
# GCP_PROJECT=ghostaff-prod
# TRANSCRIBE_MODEL=gemini-3.5-transcribe
# SECRETS_LOCATION=europe-west1
# ENGINE_SERVICE_ACCOUNT=engine@ghostaff-prod.iam.gserviceaccount.com
# Each organisation's own Google Cloud account lives here (cloudAccounts.ts); with
# ENGINE_SERVICE_ACCOUNT it turns on Claude on Vertex and customers' Google Cloud:
# TENANTS_PROJECT=ghostaff-tenants-prod
PORT=8787

# Google connector (docs/plans/ongoing/connectors.md): the OAuth client «Ghostaff
# Conectores» in ghostaff-prod. The ID is public; the secret is not. Locally it
# goes here (this file's copy, .env, is never committed); on Cloud Run it comes
# from Secret Manager (google-oauth-connectors-secret). Without both, Google is off.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Where Google sends the browser back: this engine's own address.
ENGINE_PUBLIC_URL=http://localhost:8787
# Web origins the app may come back to after connecting, comma-separated
# (the app's schemes and localhost are always allowed).
APP_RETURN_ORIGINS=

# Instagram (Instagram API with Instagram Login) and TikTok (Login Kit and the
# Content Posting API): our own apps, created in Meta for Developers and TikTok
# for Developers. Without them, those two cards answer «not available yet».
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# The record connector (docs/plans/ongoing/ordago-agents-in-ghostaff.md): our
# GitHub App «Ghostaff Registro». The id is public; the key (PEM, one line with
# \n or quoted) is in Secret Manager as github-app-registro-key. Without both, nothing syncs.
GITHUB_APP_ID=
GITHUB_APP_KEY=
# Service accounts allowed to call /cron (Cloud Scheduler's), comma-separated.
CRON_CALLERS=
